# Django Security & Core Settings
SECRET_KEY="your-production-secret-key-here"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
CSRF_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000"

# Email Configuration (SMTP)
# Leave EMAIL_HOST_USER and EMAIL_HOST_PASSWORD blank to automatically use console.EmailBackend for local development
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
DEFAULT_FROM_EMAIL="no-reply@nithome.com"

# Session & Cart
CART_SESSION_ID="nit_cart"

# Admin & Site URL
SITE_URL="http://127.0.0.1:8000"
ADMIN_EMAIL="nabil29089@gmail.com"

# SSLCommerz Payment Gateway (Defaults to public sandbox)
SSLCOMMERZ_STORE_ID="testbox"
SSLCOMMERZ_STORE_PASS="qwerty"
SSLCOMMERZ_IS_SANDBOX=True

# Steadfast Courier (Packzy) Integration
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_WEBHOOK_TOKEN="nit-courier-webhook-secret-token"

# SMS Gateway (BulkSMSBD / Alpha SMS)
