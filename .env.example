# Django Security & Core Settings
# In production (DEBUG=False), SECRET_KEY is strictly required and must be kept confidential
SECRET_KEY="your-production-secret-key-here"
DEBUG=False
ALLOWED_HOSTS="localhost,127.0.0.1,nit.pythonanywhere.com,nabil371.pythonanywhere.com"
CSRF_TRUSTED_ORIGINS="https://nit.pythonanywhere.com,https://nabil371.pythonanywhere.com,http://127.0.0.1:8000"

# Site & Admin URLs
# SITE_URL is used to generate SSLCOMMERZ success, fail, cancel, and IPN callback URLs.
# For PythonAnywhere: https://nit.pythonanywhere.com (or https://nabil371.pythonanywhere.com)
SITE_URL="https://nit.pythonanywhere.com"
ADMIN_EMAIL="admin@example.com"

# SSLCOMMERZ Hosted Checkout Configuration
# Set SSLCOMMERZ_IS_SANDBOX=True for sandbox testing; set False for live production
SSLCOMMERZ_IS_SANDBOX=True
SSLCOMMERZ_STORE_ID="<YOUR_SANDBOX_STORE_ID>"
SSLCOMMERZ_STORE_PASS="<YOUR_SANDBOX_STORE_PASSWORD>"

# Email Configuration (SMTP)
# If EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are left blank, Django defaults to console.EmailBackend
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""
DEFAULT_FROM_EMAIL="no-reply@nithome.com"

# Session & Cart
CART_SESSION_ID="nit_cart"

# Steadfast Courier (Packzy) Integration
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_WEBHOOK_TOKEN="<YOUR_COURIER_WEBHOOK_SECRET_TOKEN>"

# SMS Gateway Configuration (BulkSMSBD / Alpha SMS)
SMS_API_KEY=""
SMS_SENDER_ID=""

# Google OAuth Credentials (django-allauth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
