# Git & Version Control
.git/
.gitignore

# Environment & Secrets (Never bake secrets into Docker images)
.env*
!.env.example

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Local database & media (mounted via volumes at runtime)
*.sqlite3
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

# Tests & Coverage
tests/
.pytest_cache/
.coverage
htmlcov/
coverage/

# Node & Frontend build
node_modules/
build/
dist/

# Logs & Temporary agent files
*.log
.system_generated/
scratch/
.agents/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini
